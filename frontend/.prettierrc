{
	"semi": false,
	"tabWidth": 2,
	"useTabs": true,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"bracketSpacing": true,
	"arrowParens": "avoid",
	"trailingComma": "es5",
	"plugins": [
		"@trivago/prettier-plugin-sort-imports",
		"prettier-plugin-tailwindcss"
	],
	"importOrder": [
		"^react$",
		"^@api",
		"^@assets",
		"^@atoms",
		"^@layouts",
		"^@molecules",
		"^@organisms",
		"^@constants",
		"^@hooks",
		"^@interfaces",
		"^@pages",
		"^@router",
		"^@store",
		"^@styles",
		"^@utils",
		"<THIRD_PARTY_MODULES>",
		"^[./]"
	],
	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true
}
